{
  "name": "laguna-clara",
  "version": "2.0.0",
  "description": "Laguna Clara: dos ajolotes limpian su laguna a burbujazos.",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "build": "esbuild src/main.js --bundle --format=iife --outfile=dist/game.js",
    "dev": "esbuild src/main.js --bundle --format=iife --outfile=dist/game.js --watch --sourcemap",
    "desktop": "npm run build && electron .",
    "test": "node --test \"tests/**/*.test.js\"",
    "screenshots": "npm run build && npm --prefix mobile run build && electron scripts/screenshots.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "electron": "^33.0.0"
  }
}
